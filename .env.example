# 复制成 .env 再改。.env 不提交。

# 开发数据库（scripts/dev-db.sh up 起的容器，账号密码只用于本机）
DATABASE_URL=postgres://heyagent:heyagent@127.0.0.1:5432/heyagent
# 测试用的库：测试会清空并重新灌数据，不要指向开发库
TEST_DATABASE_URL=postgres://heyagent:heyagent@127.0.0.1:5432/heyagent_test

# 主密钥文件（scripts/dev-kek.sh 生成）；相对路径按仓库根目录算
HEYAGENT_KEK_FILE=.dev/kek

# better-auth：签名 cookie 用的密钥，至少 32 个字符。生成：openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me
# 控制台对外的地址
BETTER_AUTH_URL=http://localhost:5180
# 允许带 cookie 访问 API 的前端地址，逗号隔开（apps/web 的 dev server、整套 pod 的入口）
TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:8080,http://127.0.0.1:8080,http://192.168.31.100:5180,http://192.168.31.100:8080

# API 服务
HOST=0.0.0.0
PORT=3100

# 种子数据：5 个演示账号的密码（只用于开发和演示）
SEED_PASSWORD=heyagent-dev

# OpenRouter 的 API key（可以不填）：填了的话，空白环境初始化时自动接入 OpenRouter、刷新模型列表、设好默认模型
# OPENROUTER_API_KEY=
# 或者从文件读（整套 pod 里这样用，scripts/pod.sh 把 .env 里的 key 写进卷里 0400 的文件）；两个都有时文件优先
# OPENROUTER_API_KEY_FILE=

# 文件存储目录（上传的附件、agent 的产物）；相对路径按仓库根目录算。API 和 worker 要指向同一个目录
# HEYAGENT_FILES_DIR=.dev/files
