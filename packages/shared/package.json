{
  "name": "@heyagent/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "前后端共享：领域类型（zod schema + 推导出的 TS 类型）、中文标签、纯函数",
  "exports": {
    ".": {
      "@heyagent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "cron-parser": "5.10.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
