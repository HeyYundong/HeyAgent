{
  "name": "heyagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @heyagent/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @heyagent/server db:generate",
    "db:migrate": "pnpm --filter @heyagent/server db:migrate",
    "kek:rotate": "pnpm --filter @heyagent/server kek:rotate",
    "db:seed": "pnpm --filter @heyagent/server db:seed",
    "dev:notify": "pnpm --filter @heyagent/server dev:notify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
