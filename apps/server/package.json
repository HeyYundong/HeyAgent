{
  "name": "@heyagent/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "HeyAgent 后端：api（Hono + tRPC）；worker 在 M1 加",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@heyagent/source src/index.ts",
    "dev:worker": "tsx watch --conditions=@heyagent/source src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@heyagent/source src/db/migrate-cli.ts",
    "db:seed": "tsx --conditions=@heyagent/source src/seed/cli.ts",
    "dev:notify": "tsx --conditions=@heyagent/source src/scripts/dev-notify.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.77",
    "@heyagent/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@trpc/server": "11.19.0",
    "ai": "7.0.142",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  }
}
