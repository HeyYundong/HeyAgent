{
  "name": "@heyagent/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "HeyAgent 后端：api（Hono + tRPC）；worker 在 M1 加",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@heyagent/source src/index.ts",
    "dev:worker": "tsx watch --conditions=@heyagent/source src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@heyagent/source src/db/migrate-cli.ts",
    "db:seed": "tsx --conditions=@heyagent/source src/seed/cli.ts",
    "dev:compare-fixture": "tsx --conditions=@heyagent/source src/seed/compare-fixture-cli.ts",
    "dev:work-fixture": "tsx --conditions=@heyagent/source src/seed/work-fixture-cli.ts",
    "dev:import-fixture": "tsx --conditions=@heyagent/source src/seed/import-fixture-cli.ts",
    "dev:routine-fixture": "tsx --conditions=@heyagent/source src/seed/routine-fixture-cli.ts",
    "dev:notify": "tsx --conditions=@heyagent/source src/scripts/dev-notify.ts",
    "kek:rotate": "tsx --conditions=@heyagent/source src/scripts/kek-rotate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.81",
    "@ai-sdk/deepseek": "3.0.66",
    "@ai-sdk/mcp": "2.0.77",
    "@ai-sdk/openai": "4.0.95",
    "@ai-sdk/openai-compatible": "3.0.70",
    "@heyagent/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@playwright/mcp": "0.0.83",
    "@trpc/server": "11.19.0",
    "acorn": "8.19.0",
    "ai": "7.0.142",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "mammoth": "1.13.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "ws": "8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yazl": "3.3.1"
  },
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  }
}
