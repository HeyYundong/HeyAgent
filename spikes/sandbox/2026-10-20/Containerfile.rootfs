# sandbox rootfs (separate filesystem) copied into a worker-like image
FROM docker.io/library/python:3.12-slim-bookworm AS sandbox
RUN pip install --no-cache-dir -q pandas openpyxl \
 && apt-get update -qq && apt-get install -y -qq --no-install-recommends jq socat curl >/dev/null && rm -rf /var/lib/apt/lists/*
COPY --from=docker.io/library/node:24-bookworm-slim /usr/local/bin/node /usr/local/bin/node
RUN mkdir /workspace

FROM localhost/heyagent-worker:m1
USER root
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends bubblewrap python3 curl >/dev/null && rm -rf /var/lib/apt/lists/*
USER root
COPY --from=sandbox / /opt/sandbox-root/
USER browser
